# Copier ce fichier en .env et remplir les valeurs avant de démarrer
# Ne jamais commiter le fichier .env

# Django
DJANGO_SECRET_KEY=change_me            # Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=True                      # False en production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=suivi_tickets_db
POSTGRES_USER=suivi_tickets
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=suivi-tickets-database   # En Docker  |  localhost en dev local
POSTGRES_PORT=5432
